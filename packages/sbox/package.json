{
  "name": "@sohcah/sbox",
  "version": "0.1.0",
  "description": "Small TypeScript library and CLI over Microsandbox",
  "license": "UNLICENSED",
  "bin": {
    "sbox": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "microsandbox": "0.6.6"
  },
  "engines": {
    "node": ">=24"
  }
}
