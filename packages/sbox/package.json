{
  "name": "@sohcah/sbox",
  "version": "0.2.2",
  "description": "Small TypeScript library and CLI over Microsandbox",
  "keywords": [
    "cli",
    "docker",
    "microsandbox",
    "qemu",
    "sandbox"
  ],
  "homepage": "https://github.com/sohcah/sbox#readme",
  "bugs": {
    "url": "https://github.com/sohcah/sbox/issues"
  },
  "license": "MIT",
  "author": "sohcah",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sohcah/sbox.git",
    "directory": "packages/sbox"
  },
  "bin": {
    "sbox": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "!dist/fake-host.*",
    "!dist/fake-process.*",
    "formatter",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "cbor-x": "1.6.0",
    "ignore": "7.0.5",
    "microsandbox": "0.6.6",
    "ws": "8.18.3",
    "yaml": "2.8.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/ws": "8.18.1"
  },
  "engines": {
    "node": ">=24"
  }
}
