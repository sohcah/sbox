{
  "name": "@sohcah/sbox-sandcastle",
  "version": "0.2.6",
  "description": "Sandcastle adapter for @sohcah/sbox",
  "keywords": [
    "microsandbox",
    "sandbox",
    "sandcastle",
    "sbox"
  ],
  "homepage": "https://github.com/sohcah/sbox/tree/main/packages/sbox-sandcastle#readme",
  "bugs": {
    "url": "https://github.com/sohcah/sbox/issues"
  },
  "license": "MIT",
  "author": "sohcah",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sohcah/sbox.git",
    "directory": "packages/sbox-sandcastle"
  },
  "files": [
